---
import Base from '../layouts/Base.astro';
import { t } from '../lib/i18n';

const s = t('en');
---

<Base locale="en" title={s.notFound} description={s.notFound}>
  <main class="mx-auto max-w-3xl px-4 py-24 sm:px-6">
    <h1 class="text-2xl font-semibold">{s.notFound}</h1>
    <p class="mt-4"><a href="/">{s.backHome}</a></p>
  </main>
</Base>
