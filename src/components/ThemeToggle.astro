---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label={label}
  title={label}
  class="grid size-9 cursor-pointer place-items-center rounded-full border border-border text-muted transition-colors hover:border-accent hover:text-text"
>
  <svg class="icon-moon size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
  <svg class="icon-sun size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const dark = window.matchMedia('(prefers-color-scheme: dark)');

  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
    });
  });

  // Follow system changes until the visitor picks a theme themselves.
  dark.addEventListener('change', (e) => {
    let stored = null;
    try {
      stored = localStorage.getItem('theme');
    } catch {}
    if (!stored) root.dataset.theme = e.matches ? 'dark' : 'light';
  });
</script>
