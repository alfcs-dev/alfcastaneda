---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  name: string;
  links: { href: string; label: string }[];
  toggleLabel: string;
}
const { name, links, toggleLabel } = Astro.props;
---

<header class="no-print sticky top-0 z-10 border-b border-border/70 bg-bg/80 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-6 px-4 sm:px-6">
    <a href="#top" class="font-serif text-xl no-underline">{name}</a>
    <div class="flex items-center gap-6">
      <ul class="hidden items-center gap-6 text-sm md:flex">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="text-muted no-underline hover:text-text">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle label={toggleLabel} />
    </div>
  </nav>
</header>
