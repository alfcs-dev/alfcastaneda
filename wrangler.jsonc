// Cloudflare Workers (static assets) config.
// Workers Builds runs `npm run build`, then deploys ./dist.
{
  "name": "alfcastaneda",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Required by `wrangler preview`, which Workers Builds runs for non-production branches (e.g. PRs).
  "previews": {}
}
